          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Settlement lifecycle",
            "pages": [
              "api-reference/endpoint/estimate",
              "api-reference/endpoint/transfer",
              "api-reference/endpoint/status"
            ]
          },
