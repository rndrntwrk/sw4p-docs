          }
        ]
      }
    ],
    "global": {
      "anchors": [
        { "anchor": "SW4P", "href": "https://sw4p.io", "icon": "arrows-rotate" },
        { "anchor": "RNDRNTWRK", "href": "https://www.rndrntwrk.com/", "icon": "network-wired" },
        { "anchor": "Design partners", "href": "https://www.rndrntwrk.com/partners", "icon": "handshake" }
